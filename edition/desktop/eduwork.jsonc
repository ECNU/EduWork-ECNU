// EduWork@ECNU 的公开发行默认配置。不含实际机构 Client ID 或个人凭据。
// 维护者下载 CI 包后，用 configure-desktop-archive.ps1 加入私有学校配置。
// 运行时读取 config/eduwork.<产品版本>.jsonc，学校配置随发行统一更新。
// 完整格式和字段说明见 config/examples；示例的 Client ID 占位符不能直接登录。
// 使用者无需编辑此配置。个人设置、凭据和 data 与学校配置分开保留。
{
  "schemaVersion": 1,
  "product": { "name": "EduWork@ECNU" },
  "organizations": [],
  "updates": {},
  "features": { "maxConcurrentRequests": 3 },
  "desktop": { "closeAction": "tray" }
}
